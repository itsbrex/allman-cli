{
  "name": "allman-cli",
  "version": "0.4.0-rc.1",
  "description": "LinkedIn messenger from the CLI",
  "type": "module",
  "bin": {
    "allman": "./dist/allman"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun scripts/build.ts",
    "build:node": "bun build src/index.ts --target=node --packages=external --outfile=dist/allman-node.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests",
    "lint:fix": "biome check --write src tests",
    "format": "biome format --write src tests",
    "install-browsers": "bunx playwright install chromium",
    "link": "bun scripts/dev-link.ts",
    "unlink": "bun scripts/dev-link.ts --remove",
    "release": "bun scripts/release.ts",
    "plans": "bun scripts/plans.mjs",
    "activity:build": "bun scripts/build-activity-app.ts",
    "activity:share": "bun scripts/build-activity-share.ts",
    "activity:serve": "bun run plans serve --local --name allman-activity bun scripts/serve-activity.ts",
    "activity:qa": "bun scripts/qa-activity-app.ts",
    "prepare": "husky",
    "apps:build": "bun run activity:build && bun run plans index --quiet",
    "apps:check": "bun scripts/check-apps.ts",
    "build:all": "bun run apps:build && bun run build && bun run build:node",
    "activity:check": "bun scripts/build-activity-app.ts --check",
    "enrichment:build": "bun scripts/build-enrichment-review.ts",
    "enrichment:review": "bun run src/index.ts --no-dashboard enrich-list review --html",
    "enrichment:serve": "bun run plans serve --local --name allman-enrichment bun scripts/serve-enrichment-review.ts",
    "enrichment:qa": "bun scripts/qa-target-enrichment.ts",
    "plans:build": "bun run plans index --quiet",
    "atlas:open": "open docs/browser-atlas/index.html",
    "artifacts:new": "bun scripts/artifact-directory.ts",
    "artifacts:recover": "python3 scripts/preserve-temp.py",
    "test:recovery": "python3 scripts/test_preserve_temp.py",
    "check": "bun run typecheck && bun run apps:check && bun run test:recovery && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@types/node": "^25.5.0",
    "@types/tough-cookie": "^4.0.5",
    "@types/tunnel": "^0.0.7",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "^4.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.14.0",
    "commander": "^14.0.3",
    "playwright": "^1.58.2",
    "simple-git": "^3.33.0",
    "tough-cookie": "^6.0.1",
    "tunnel": "^0.0.6",
    "ws": "8.21.3"
  }
}
